ARG BASE_IMAGE=vllm/vllm-openai:v0.26.0
FROM ${BASE_IMAGE}

ARG QC_PATCH_COMMIT=unknown
LABEL org.opencontainers.image.title="vLLM OpenAI qc-patch"
LABEL org.opencontainers.image.base.name="vllm/vllm-openai:v0.26.0"
LABEL org.opencontainers.image.revision="${QC_PATCH_COMMIT}"

# The base image already contains the v0.26.0 wheel and compiled CUDA
# extensions. Overlay the Python package from qc-patch while retaining those
# binary extensions.
COPY vllm/ /usr/local/lib/python3.12/dist-packages/vllm/
